# Campus Bites admin web — copy to apps/web/.env.local (git-ignored). Vite exposes only VITE_* vars,
# and everything here ends up in the browser bundle: never put the Supabase secret key here.

# Supabase dashboard → Project Settings → API (same values as the mobile app's EXPO_PUBLIC_* ones).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# FastAPI base URL, no trailing slash. Its CORS_ORIGINS must include this site's origin.
VITE_API_URL=http://127.0.0.1:8000
