# Campus Bites mobile app — copy to apps/mobile/.env.local (git-ignored) and fill in.
# Every EXPO_PUBLIC_* value is compiled INTO the app bundle and is readable by anyone who has
# the app. Never put a secret here (no Supabase secret/service-role key, no API secrets).

# Supabase dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase dashboard → Project Settings → API Keys → Publishable key (sb_publishable_…).
# Safe to ship: Row Level Security decides what it can read or write.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# FastAPI base URL, no trailing slash. A phone can't reach your PC's "localhost":
#   - device / dev build:  the deployed API, e.g. https://<service>.onrender.com
#   - Android emulator:    http://10.0.2.2:8000
#   - iOS simulator / web: http://localhost:8000
EXPO_PUBLIC_API_URL=https://<service>.onrender.com

# Not an env var: push notifications need the EAS projectId, written into app.json
# (expo.extra.eas.projectId) by running `eas init` once in apps/mobile.

# ─── Google Maps (eatery map) ────────────────────────────────────────────────
# Google Cloud → APIs & Services. Restrict every key to its platform; none of them is a secret.
#
# Web (Maps JavaScript API). Compiled into the web bundle: restrict by HTTP referrer
# (e.g. http://localhost:8081/*, your hosted web origin).
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
#
# Native (Maps SDK for Android / Maps SDK for iOS). Read by app.config.ts at BUILD time and written
# into the native project, not into the JS bundle. Restrict Android to package in.ac.iitr.campusbites
# + the build's SHA-1, iOS to bundle id in.ac.iitr.campusbites. For EAS builds, set them as EAS
# environment variables instead. Expo Go on Android needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
