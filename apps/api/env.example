# Campus Bites API — copy to apps/api/.env.local (git-ignored) for local runs.
# On Render: set the same keys in the service's Environment tab (no file needed there).
# Loaded by app/core/config.py (pydantic-settings); real environment variables win over files.

# development | test | production. "production" hides /docs and /openapi.json.
ENVIRONMENT=development

# Supabase dashboard → Project Settings → API → Project URL. The JWKS URL used to verify user
# tokens is derived from it ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) — don't set it.
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase dashboard → Project Settings → API Keys → Secret key (sb_secret_…).
# SERVER ONLY: bypasses Row Level Security. Never commit it, never put it in the mobile app.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret for /internal/* endpoints called by pg_cron (M6 escalation sweep). Must equal
# the Supabase Vault secret `internal_cron_secret`. Generate 32+ random bytes, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_CRON_SECRET=change-me-to-a-long-random-string

# Optional. Only if "Enhanced push security" is on in expo.dev → Project → Credentials
# (expo.dev → Account settings → Access tokens). Leave empty otherwise.
EXPO_ACCESS_TOKEN=

# Optional JSON list of browser origins. Native apps don't use CORS; only the web build does.
CORS_ORIGINS=["http://localhost:8081"]
