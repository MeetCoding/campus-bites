# Copy to apps/api/.env for local dev. On Render, set these in the service's Environment tab.
ENVIRONMENT=development
SUPABASE_URL=https://sdjghovuyhsiyufhmlga.supabase.co
# Supabase dashboard → Project Settings → API Keys → Secret key (sb_secret_...). Server-only.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
# Shared with the pg_cron caller (Supabase Vault secret `internal_cron_secret`).
INTERNAL_CRON_SECRET=change-me-long-random-string
# Optional: Expo push access token (expo.dev → Access tokens) if enhanced push security is on.
EXPO_ACCESS_TOKEN=
# JSON list; only needed for the web build.
CORS_ORIGINS=["http://localhost:8081"]
